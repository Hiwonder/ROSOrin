<?xml version="1.0"?>
<launch>
    <arg name="depth_camera_type"   value="$(env DEPTH_CAMERA_TYPE)" doc="depth_camera_type [dabai, ascamera]"/>
    <arg name="depth_camera_name"   default="depth_cam"/>
    <arg name="image_topic"         default="image_raw"/>
    <arg name="tf_prefix"           default="" />
    <arg name="app"                 default="false"/>
    <arg name="pi/2"                value="1.5707963267948966" />
    <arg name="pi"                  value="3.1415926535897932" />

    <param name="depth_camera/camera_name"  value="$(arg depth_camera_name)"/>
    <param name="depth_camera/image_topic"  value="$(arg image_topic)"/>

    <include if="$(eval depth_camera_type == 'ascamera')" file="$(find peripherals)/launch/include/hp60c.launch">
        <arg name="tf_prefix" value="$(arg tf_prefix)" />
        <arg name="camera_name" value="$(arg depth_camera_name)" />
    </include>

    <include if="$(eval depth_camera_type == 'dabai')" file="$(find peripherals)/launch/include/dabai_dcw.launch">
        <arg name="camera_name"     value="$(arg depth_camera_name)" />
        <arg name="tf_prefix"       value="$(arg tf_prefix)" />
        <arg name="publish_tf"      value="false" />
    </include>

    <include if="$(eval depth_camera_type == 'aurora')" file="$(find peripherals)/launch/include/aurora930.launch">
        <arg name="camera_name"     value="$(arg depth_camera_name)" />
        <arg name="tf_prefix"       value="$(arg tf_prefix)" />
        <arg name="publish_tf"      value="false" />
    </include>

    <include if="$(eval depth_camera_type == 'csi')" file="$(find peripherals)/launch/include/csi_camera.launch">
    </include>

    <include if="$(eval depth_camera_type == 'usb_cam')" file="$(find peripherals)/launch/usb_cam.launch">
        <arg name="camera_name"     value="$(arg depth_camera_name)" />
    </include>

    <node if="$(arg app)" name="image_republish" pkg="image_transport" type="republish" args="raw compressed">
        <remap from="in" to="/$(arg depth_camera_name)/rgb/image_raw"/>
        <remap from="out" to="/$(arg depth_camera_name)/rgb/image_raw"/>
        <remap from="/$(arg depth_camera_name)/rgb/image_raw/compressed" to="/compressed_image"/>
    </node>

    <group if="$(eval arg('depth_camera_type')=='ascamera')">
    <node pkg="tf2_ros" type="static_transform_publisher" name="depth_link"
      args="0 0 0 0 0 0 $(arg tf_prefix)camera_link0 $(arg tf_prefix)depth_frame0" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="rgb_link"
      args="0 0.0203 0 -$(arg pi/2) 0 -$(arg pi/2) $(arg tf_prefix)camera_link0 $(arg tf_prefix)color_frame0" />
    </group>

    <group if="$(eval arg('depth_camera_type')=='dabai')">
    <arg name="optical_rotate" value="0 0 0 -$(arg pi/2) 0 -$(arg pi/2)" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="$(arg depth_camera_name)_base_link"
        args="0 0.02 0 0 0 0 $(arg tf_prefix)$(arg depth_camera_name)_link $(arg tf_prefix)$(arg depth_camera_name)_depth_frame" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="$(arg depth_camera_name)_base_link1"
        args="0 0.01 0 0 0 0 $(arg tf_prefix)$(arg depth_camera_name)_link $(arg tf_prefix)$(arg depth_camera_name)_color_frame" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="$(arg depth_camera_name)_base_link2"
        args="$(arg optical_rotate) $(arg tf_prefix)$(arg depth_camera_name)_depth_frame $(arg tf_prefix)$(arg depth_camera_name)_depth_optical_frame" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="$(arg depth_camera_name)_base_link3"
        args="$(arg optical_rotate) $(arg tf_prefix)$(arg depth_camera_name)_color_frame $(arg tf_prefix)$(arg depth_camera_name)_color_optical_frame" />
    </group>

    <group if="$(eval arg('depth_camera_type')=='aurora')">
        <node pkg="tf2_ros" type="static_transform_publisher" name="depth_link"
        args="0 0 0 $(arg pi/2) $(arg pi) $(arg pi/2) $(arg tf_prefix)camera_link0 $(arg tf_prefix)depth_camera_link" />
    </group>

</launch>
