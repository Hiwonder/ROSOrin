<?xml version="1.0"?>
<!--肢体控制-->
<launch>
    <include file="$(find peripherals)/launch/depth_cam.launch"/>
    <!--底盘驱动(chassis driver)-->
    <include file="$(find controller)/launch/controller.launch"/>

    <node pkg="example" type="body_control.py" name="body_control" output="screen"/>
</launch>
